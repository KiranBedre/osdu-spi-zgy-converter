set(PACKAGE_NAME "opentelemetry-cpp")
set(RESULTING_MESSAGE "Found ${PACKAGE_NAME}: no")
find_package(CURL QUIET)
if(CURL_FOUND)
    find_package(${PACKAGE_NAME} QUIET)
    if(${PACKAGE_NAME}_FOUND)
        string(REPLACE " no" " ${${PACKAGE_NAME}_DIR}" RESULTING_MESSAGE ${RESULTING_MESSAGE})
    endif()
endif()
message(STATUS ${RESULTING_MESSAGE})
