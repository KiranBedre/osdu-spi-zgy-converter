message(CHECK_START "Locating cpprestsdk ... ")
if (MSVC)
    if(DEFINED ENV{VCPKG_HOME})
        if(NOT DEFINED CMAKE_TOOLCHAIN_FILE) 
            set(CMAKE_TOOLCHAIN_FILE "$ENV{VCPKG_HOME}/scripts/buildsystems/vcpkg.cmake") 
        endif()
	
        if(NOT DEFINED VCPKG_LIBRARY_PATH)
            if(${CMAKE_BUILD_TYPE} STREQUAL "Debug")             
                set(VCPKG_LIBRARY_PATH "$ENV{VCPKG_HOME}/installed/x64-windows/debug")
            else()
                set(VCPKG_LIBRARY_PATH "$ENV{VCPKG_HOME}/installed/x64-windows")
            endif()
        endif()
        if(NOT DEFINED CPPRESTSDK_HOME)
            set(CPPRESTSDK_HOME "${VCPKG_LIBRARY_PATH}")
            set(ENV{CPPRESTSDK_HOME} "${CPPRESTSDK_HOME}")
            set(CPPRESTSDK_ROOT_DIR "${VCPKG_LIBRARY_PATH}")
            set(CPPRESTSDK_USE_STATIC_LIBS false)
            set(ENV{CPPRESTSDK_USE_STATIC_LIBS} "${CPPRESTSDK_USE_STATIC_LIBS}")
	    set(cpprestsdk_DIR "$ENV{VCPKG_HOME}/installed/x64-windows/share/cpprestsdk")
            set(ZLIB_LIBRARY   "${VCPKG_LIBRARY_PATH}/lib")
            set(unofficial-brotli_DIR "$ENV{VCPKG_HOME}/installed/x64-windows/share/unofficial-brotli")
        endif()

        if (NOT DEFINED vcpkg_INCLUDE_PATH)
            if(${CMAKE_SYSTEM_NAME} MATCHES "Linux")  
    	        set(VCPKG_INCLUDE_PATH "/usr/include/")
            else()
    	        set(VCPKG_INCLUDE_PATH "$ENV{VCPKG_HOME}/installed/x64-windows/include/")
            endif()
        endif()
	if (NOT DEFINED VCPKG_INCLUDE_PATH)
            if(${CMAKE_SYSTEM_NAME} MATCHES "Linux")  
    	        set(VCPKG_INCLUDE_PATH "/usr/include/")
            else()
    	        set(VCPKG_INCLUDE_PATH "$ENV{VCPKG_HOME}/installed/x64-windows/include/")
            endif()
        endif()
    endif()
endif()

find_package(cpprestsdk CONFIG REQUIRED)
if(NOT DEFINED cpprestsdk_FOUND)
    message(CHECK_FAIL "Unable to locate cpprestsdk")
endif()

if (${CMAKE_SYSTEM_NAME} MATCHES "Linux")
    set (CPPRESTSDK_LINK_LIBS cpprest)
elseif (${CMAKE_SYSTEM_NAME} MATCHES "Windows")
    set (CPPRESTSDK_LINK_LIBS cpprestsdk::cpprest cpprestsdk::cpprestsdk_zlib_internal cpprestsdk::cpprestsdk_brotli_internal)
endif()

