if(DEFINED ENV{SEGYSDK_VER_MAJOR})
set(SEGYSDK_VER_MAJOR $ENV{SEGYSDK_VER_MAJOR})
endif()
if(DEFINED ENV{SEGYSDK_VER_MINOR})
set(SEGYSDK_VER_MINOR $ENV{SEGYSDK_VER_MINOR})
endif()
if(DEFINED ENV{SEGYSDK_VER_PATCH})
set(SEGYSDK_VER_PATCH $ENV{SEGYSDK_VER_PATCH})
endif()
if(DEFINED ENV{SEGYSDK_VER_BUILD})
set(SEGYSDK_VER_BUILD $ENV{SEGYSDK_VER_BUILD})
endif()

if("${SEGYSDK_VER_BUILD}" STREQUAL "")
set(SEGYSDK_VER_BUILD 0)
endif()

if(("${SEGYSDK_VER_MAJOR}" STREQUAL "") OR ("${SEGYSDK_VER_MINOR}" STREQUAL "") OR ("${SEGYSDK_VER_PATCH}" STREQUAL ""))
    message(STATUS "Version variables not set: SEGYSDK_VER_MAJOR SEGYSDK_VER_MINOR SEGYSDK_VER_PATCH (optional SEGYSDK_VER_BUILD). Using default version 0.0.0.0. It is safe to ignore this message for local development.")
    set(SEGYSDK_VER_MAJOR 0)
    set(SEGYSDK_VER_MINOR 0)
    set(SEGYSDK_VER_PATCH 0)
    set(SEGYSDK_VER_BUILD 0)
endif()
set(SEGYSDK_VERSION "${SEGYSDK_VER_MAJOR}.${SEGYSDK_VER_MINOR}.${SEGYSDK_VER_PATCH}.${SEGYSDK_VER_BUILD}")

configure_file(${CMAKE_CURRENT_LIST_DIR}/../VersionInfo.rc.in VersionInfo.rc)
